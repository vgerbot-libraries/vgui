---
import { Code } from '@astrojs/starlight/components';
import { basePath } from '../utils/paths';
import counterSource from '../../../crates/vgui/examples/counter.rs?raw';

const componentSources = import.meta.glob('../../../crates/vgui-shadcn/examples/*.rs', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

interface Props {
  example?: string;
  codeLabel?: string;
  previewLabel?: string;
  loadingLabel?: string;
  previewTitle?: string;
}

const {
  example = 'counter',
  codeLabel = 'Rust source',
  previewLabel = 'Live WASM preview',
  loadingLabel = 'Loading WebAssembly…',
  previewTitle,
} = Astro.props;

const sourcePath = `../../../crates/vgui-shadcn/examples/${example}.rs`;
const source = example === 'counter' ? counterSource : componentSources[sourcePath];
if (!source) {
  throw new Error(`No Rust source found for live example "${example}".`);
}

const previewSrc =
  example === 'counter'
    ? basePath('wasm/counter/index.html')
    : `${basePath('wasm/index.html')}?example=${encodeURIComponent(example)}`;
const resolvedPreviewTitle =
  previewTitle ??
  (example === 'counter'
    ? 'Interactive vgui counter'
    : `Interactive vgui ${example.replaceAll('_', ' ')} example`);
---

<div class="live-rust-example not-content" data-example={example}>
  <section class="live-rust-source" aria-label={codeLabel}>
    <div class="live-rust-code">
      <Code code={source} lang="rust" title={`${example}.rs`} />
    </div>
  </section>
  <section class="live-rust-preview" aria-label={previewLabel}>
    <div class="live-rust-frame">
      <span class="live-rust-loading" aria-hidden="true">{loadingLabel}</span>
      <iframe
        src={previewSrc}
        title={resolvedPreviewTitle}
        loading="lazy"
        sandbox="allow-scripts allow-same-origin"
      ></iframe>
    </div>
  </section>
</div>

<style>
  .live-rust-example {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-block: 1.5rem;
  }

  .live-rust-source,
  .live-rust-preview {
    min-width: 0;
  }

  .live-rust-code {
    height: 32rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
  }

  .live-rust-code :global(.expressive-code) {
    height: 100%;
    min-width: 0;
    margin-block: 0;
  }

  .live-rust-code :global(.expressive-code .frame) {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-width: 0;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .live-rust-code :global(.expressive-code pre) {
    flex: 1;
    min-height: 0;
  }

  .live-rust-frame {
    position: relative;
    height: 32rem;
    overflow: hidden;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: #2e2e2e;
  }

  .live-rust-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #fff;
    font-size: var(--sl-text-sm);
    pointer-events: none;
  }

  .live-rust-frame iframe {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 72rem) {
    .live-rust-example {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
